from __future__ import annotations

from pydantic import BaseModel
{% if imports %}
{{ imports }}
{% endif %}
{% for entry in classes %}
{% if entry.kind == "class" %}


class {{ entry.class_name }}(BaseModel):
{%- if entry.has_aliases %}
    model_config = ConfigDict(populate_by_name=True)
{%- endif %}
{%- for field in entry.fields %}
    {{ field.name }}: {{ field.annotation }}{{ field.default }}
{%- endfor %}
{% elif entry.kind == "union" %}


{{ entry.alias_name }} = Annotated[
    {{ entry.members | join("\n    | ") }},
    Field(discriminator="typename"),
]
{% endif %}
{% endfor %}


class {{ result_class }}(BaseModel):
{%- if result_has_aliases %}
    model_config = ConfigDict(populate_by_name=True)
{%- endif %}
{%- for field in result_fields %}
    {{ field.name }}: {{ field.annotation }}{{ field.default }}
{%- endfor %}
