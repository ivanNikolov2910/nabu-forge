from pydantic import BaseModel
{% if imports %}
{{ imports }}
{% endif %}
{% for model in models %}


class {{ model.class_name }}(BaseModel):
{%- if model.has_aliases %}
    model_config = ConfigDict(populate_by_name=True)
{%- endif %}
{%- for field in model.fields %}
    {{ field.name }}: {{ field.annotation }}{{ field.default }}
{%- endfor %}
{% endfor %}
